---
// PostHog — scroll depth and clickmaps only.
//
// WHY THIS EXISTS. Vercel Web Analytics (the /_vercel/insights script in
// Layout.astro) answers "did anyone arrive?". It does not answer "did anyone
// finish reading?", and custom events on it need a Pro plan. The content
// machine already measures TikTok / Instagram / LinkedIn impressions in
// cm_post_metrics; the funnel then goes dark at exactly the point where the
// writing gets judged. This closes that.
//
// WHAT IS DELIBERATELY OFF:
//   disable_session_recording — session replay is a new pool of visitor PII on
//   a project that already carries a real PIPEDA obligation elsewhere
//   (SecondBrain/memory/data-handling.md). One scroll line is not worth it.
//   Read depth and clickmaps do NOT need recordings. Depth comes from our own
//   `read_depth` event (see below); clicks come from autocapture.
//
//   person_profiles: 'identified_only' — nobody logs in here, so no profiles
//   get created and PostHog stores events without building a person record.
//
// The project token is a WRITE-ONLY public key. It ships to the browser by
// design; it is not a secret and it cannot read data back. Reading is done
// server-side by content-machine/scripts/site.mjs with a personal API key that
// never touches this repo.
//
// Set PUBLIC_POSTHOG_KEY in Vercel → Project → Settings → Environment
// Variables (Production). With it unset, this component renders nothing, so
// local dev and previews stay clean.
const key = import.meta.env.PUBLIC_POSTHOG_KEY;
const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://us.i.posthog.com';
---
{
  import.meta.env.PROD && key && (
    <script is:inline define:vars={{ key, host }}>
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split('.');
              2 == o.length && ((t = t[o[0]]), (e = o[1]));
              t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              };
            }
            ((p = t.createElement('script')).type = 'text/javascript'),
              (p.crossOrigin = 'anonymous'),
              (p.async = !0),
              (p.src = s.api_host + '/static/array.js'),
              (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
            var u = e;
            for (
              void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
                u.people = u.people || [],
                u.toString = function (t) {
                  var e = 'posthog';
                  return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
                },
                u.people.toString = function () {
                  return u.toString(1) + '.people (stub)';
                },
                o =
                  'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug'.split(
                    ' '
                  ),
                n = 0;
              n < o.length;
              n++
            )
              g(u, o[n]);
            e._i.push([i, s, a]);
          }),
          (e.__SV = 1));
      })(document, window.posthog || []);

      // NO `defaults` KEY. The guide's snippet carries `defaults: '<a date>'`,
      // and the date it ships is not a value posthog-js knows. Deployed with
      // it, this page fired $pageleave but NEVER $pageview, and every
      // $prev_pageview_max_*_percentage came back null -- so read depth would
      // have recorded nothing, forever, while the dashboard showed traffic and
      // the script threw no error. [verified against live events 2026-09-07]
      // Every option below is therefore set explicitly rather than inherited.
      posthog.init(key, {
        api_host: host,
        capture_pageview: true,
        capture_pageleave: true,
        autocapture: true,
        // Everything below is a deliberate no.
        disable_session_recording: true,
        person_profiles: 'identified_only',
        respect_dnt: true,
      });

      // Our own read-depth event, and not PostHog's implicit scroll properties.
      //
      // Those properties are attached to the NEXT pageview rather than to the
      // event you are reading, which makes them quietly dependent on plumbing
      // we do not control and cannot see fail -- which is exactly how they
      // failed above. This computes the number here, names it, and sends it.
      // If it is ever wrong, it is wrong in code we can read.
      //
      // Percentage of the DOCUMENT that has been reached, not of the scrollbar:
      // a reader who reaches the last paragraph has finished the piece even
      // though the footer is still below them.
      (function () {
        var maxPct = 0;
        var sent = false;

        // Scrollable distance. Returns 0 when the page does not scroll -- which
        // is EITHER a genuinely short page OR a layout that has not happened
        // yet, and those two must not be treated the same.
        function scrollable() {
          return document.documentElement.scrollHeight - window.innerHeight;
        }

        function mark() {
          var h = scrollable();
          if (h <= 0) return;           // nothing to measure YET, or ever
          var pct = Math.min(1, (window.scrollY || 0) / h);
          if (pct > maxPct) maxPct = pct;
        }

        function send() {
          if (!window.posthog || sent) return;
          sent = true;
          // Measure once more with the layout finally settled. Without this a
          // reader who never scrolled a long page would report 0 -- and, worse,
          // the ONLY place it is safe to conclude "no scrollbar, so they saw
          // the whole thing" is here, at the end, when the page is really laid
          // out.
          mark();
          var pct = scrollable() <= 0 ? 1 : maxPct;
          posthog.capture('read_depth', {
            path: location.pathname,
            pct: Math.round(pct * 100) / 100,
          });
        }

        // NO mark() ON LOAD. This script runs in <head>, before the body
        // exists, so scrollHeight is about one viewport and the scrollable
        // distance is <= 0. The first version treated that as "no scrollbar,
        // therefore fully read", pinned maxPct to 1, and -- because maxPct only
        // ever goes up -- every single visitor reported 100%. The events
        // arrived, the dashboard filled, the number was garbage.
        // [caught 2026-09-07 by scrolling 25% and being told it was 100%]
        window.addEventListener('scroll', mark, { passive: true });
        // pagehide fires on bfcache navigations where unload does not;
        // visibilitychange covers the tab being switched away from and the
        // mobile case where neither of the others is guaranteed to run.
        window.addEventListener('pagehide', send);
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') send();
        });
      })();
    </script>
  )
}
