---
/**
 * The site's navigation. One link list, two presentations.
 *
 *   variant="bar"     — fixed blend-difference bar. Inner pages, on ink.
 *   variant="corners" — four pinned corners + a top-centre link. Landing hero, on paper.
 *
 * The two look nothing alike on purpose: a landing hero earns attention, an
 * article index gets out of the way. What they must never do is drift apart in
 * CONTENT — before this component existed the link list was hardcoded twice, so
 * every fix to one silently skipped the other.
 *
 * Which accent responds is decided by the ground, not by this file.
 * See DESIGN.md → The Ground Decides Rule.
 */
interface Props {
  variant?: 'bar' | 'corners';
}
const { variant = 'bar' } = Astro.props;

type NavLink = {
  href: string;
  label: string;
  /** Corner slot. Only meaningful for variant="corners". */
  slot?: 'tl' | 'tr' | 'bl' | 'br' | 'tc';
  /** Rendered only in the corners variant. Flip to false to surface it in the bar too. */
  cornersOnly?: boolean;
  /** Shorter label for narrow screens. */
  short?: string;
};

const LINKS: NavLink[] = [
  { href: '/writing',  label: 'WRITING',      slot: 'tl' },
  { href: '/projects', label: 'PROJECTS',     slot: 'tr' },
  { href: '/about',    label: 'ABOUT',        slot: 'bl' },
  { href: '/#contact', label: 'CONTACT',      slot: 'br' },
  { href: '/ctf',      label: '⚑ GUARD BOT',  slot: 'tc', cornersOnly: true, short: '⚑ CTF' },
];

const barLinks = LINKS.filter((l) => !l.cornersOnly);
---

{variant === 'bar' && (
  <nav class="site-nav" id="site-nav">
    <a href="/" class="nav-logo">maystash<span class="blink">▮</span></a>
    <div class="nav-links mono">
      {barLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <div class="nav-right">
      <span class="nav-slate mono">EST. 2026</span>
    </div>
  </nav>
)}

{variant === 'corners' && (
  <nav class="corners mono">
    {LINKS.map((l) => (
      <a href={l.href} class={`corner ${l.slot}`}>
        {l.short
          ? (<><span class="tc-long">{l.label}</span><span class="tc-short">{l.short}</span></>)
          : l.label}
      </a>
    ))}
  </nav>
)}

<style>
  /* ================= variant: bar =================
     Two states:
       ghost  — mix-blend difference, invisible chrome; logo inverts over colour
                plates (hero, marquee, cards).
       slated — once prose scrolls underneath, the logo snaps into an ink "slate
                chip" so it never mushes into text. */
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 2rem;
    mix-blend-mode: difference;
  }
  .nav-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step-base);
    letter-spacing: 0.02em;
    color: var(--bone);
    text-decoration: none;
    padding: 0.45rem 0.9rem;
    margin-left: -0.9rem;
    border-radius: var(--r-pill);
    border: 1px solid transparent;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .site-nav.slated { mix-blend-mode: normal; }
  .site-nav.slated .nav-logo {
    background: var(--ink-a82);
    border-color: var(--rule);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
  }
  .site-nav.slated .nav-logo:hover { border-color: var(--acid); }
  .site-nav.slated .nav-slate { opacity: 0; }
  .blink { animation: blink 1.1s steps(1) infinite; color: var(--acid); }
  @keyframes blink { 50% { opacity: 0; } }
  .nav-slate { color: var(--bone-dim); transition: opacity 0.3s ease; }
  @media (max-width: 720px) { .nav-slate { display: none; } }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-links a {
    color: var(--bone);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: color var(--dur-state) ease;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible { color: var(--acid); }
  @media (max-width: 720px) {
    .nav-links {
      position: static;
      transform: none;
      gap: 0.9rem;
      font-size: var(--step-floor);
    }
    .nav-links a { letter-spacing: 0.04em; }
  }
  /* Below 400px the wordmark, not the links, gives ground. Link size is held at
     the floor; the logo shrinks and the gutters tighten instead. */
  @media (max-width: 400px) {
    .site-nav { padding: 1.1rem 0.7rem; }
    .nav-links { gap: 0.4rem; }
    .nav-links a { letter-spacing: 0.01em; }
    .nav-logo {
      font-size: 0.8rem;
      padding: 0.45rem 0.5rem;
      margin-left: -0.5rem;
    }
  }

  .nav-right { display: flex; align-items: center; gap: 1.3rem; }

  /* ================= variant: corners =================
     Absolutely positioned against the hero (.launch), which owns the paper
     ground and the padding these sit inside. */
  .corner {
    position: absolute;
    z-index: 3;
    color: var(--paper-ink);
    text-decoration: none;
    font-size: var(--step-meta);
    letter-spacing: 0.14em;
    padding: 0.5rem 0.2rem;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-state) ease, color var(--dur-state) ease;
  }
  /* Klein, not acid: acid on paper measures 1.02:1. See The Ground Decides Rule. */
  .corner:hover,
  .corner:focus-visible { border-color: var(--klein); color: var(--klein); }

  /* Top-centre, opposite the bottom-centre scroll cue. */
  .corner.tc {
    top: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--paper-ink);
    border-color: var(--ink-a35);
  }
  .tc-short { display: none; }
  .tl { top: 2rem; left: 2.2rem; }
  .tr { top: 2rem; right: 2.2rem; }
  .bl { bottom: 2rem; left: 2.2rem; }
  .br { bottom: 2rem; right: 2.2rem; }

  @media (max-width: 620px) {
    /* The full label would crowd WRITING and PROJECTS on a narrow screen. */
    .corner.tc { top: 1.1rem; }
    .tc-long { display: none; }
    .tc-short { display: inline; }

    /* Keep the four-corner layout on phones — links stay pinned, just tighter in.
       0.75rem = 12px: above the 11.2px floor on purpose. This is the landing
       page's only navigation, competing with a full-bleed wordmark; the floor is
       a minimum for footnotes, not a target for primary nav. */
    .corner {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      white-space: nowrap;
    }
    .tl { top: 1.1rem; left: 1.1rem; }
    .tr { top: 1.1rem; right: 1.1rem; }
    .bl { bottom: 1.1rem; left: 1.1rem; }
    .br { bottom: 1.1rem; right: 1.1rem; }
  }
</style>
