    .marquee-track { animation: none; }
  }
</style>

<script>
  // ---- The Currency Rule, client half -----------------------------------
  // The page is static, so its freshness answer is frozen at build time — and a
  // page that hasn't been rebuilt in months is exactly the page most likely to
  // be lying about being current. Re-check against the real clock on load.
  // No JS: the build-time label stands, which is the old behaviour, not a break.
  {
    const kick = document.querySelector('.strip-kick[data-fresh-until]');
    const until = kick ? Date.parse(kick.getAttribute('data-fresh-until') || '') : NaN;
    if (kick && Number.isFinite(until) && Date.now() > until) {
      kick.textContent = 'LAST SCREENED';
    }
  }

  // Kept short on purpose: the bubble is white-space:nowrap, so anything much
  // past ~42 characters runs off the edge on a narrow phone.
  const lines = [
    "Hey, I'm May 👋",
    'I build things from zero.',
    'Security. Web3. AI. Pick one.',
    'Ask me anything — I mean it.',
    'Someone cheated at my game for weeks.',
    'Your burger drinks more than AI does.',
    'This whole site is just text files.',
    'The hard-won stuff is written down.',
    "Dinjure's live — go lose a round.",
    'My AI lives in a group chat.',
    'I like the part before anything exists.',
    'Currently shipping something new.',
    'Still awake. Still building.',
    'Ship, then breathe. Then ship again.',
  ];
  const bubble = document.getElementById('bubble');
  const av = document.getElementById('av');
  const btn = document.getElementById('avatar');
  let i = 0;

  // ---- pose engine: cross-fade between the real memoji frames ----
  // `img.pose` and not `.pose`: the motion <video>s share the class for layout
  // and would otherwise register under an empty pose name.
  const frames = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('img.pose').forEach((el) => {
    frames.set(el.dataset.pose ?? '', el);
  });

  // Motion clips stand in for a still once they can actually play. Until then,
  // and forever if they never load, the still is used, so a slow network or a
  // refused autoplay degrades to the old page rather than to an empty disc.
  const motion = new Map<string, HTMLVideoElement>();
  let current = 'idle';
  let shown: HTMLElement | undefined = frames.get('idle');

  const show = (name: string) => {
    const next = motion.get(name) ?? frames.get(name);
    if (!next || next === shown) return;
    if (next instanceof HTMLVideoElement) {
      if (!next.loop) next.currentTime = 0;       // one-shot clips start from the top
      next.play().catch(() => {                   // low-power mode, autoplay policy
        motion.delete(name);
        if (current === name) show(name);         // fall back to the still
      });
    }
    next.classList.add('is-on');
    const prev = shown;
    prev?.classList.remove('is-on');
    // Pause a clip once it has faded out, not before, or the cross-fade freezes.
    if (prev instanceof HTMLVideoElement) {
      window.setTimeout(() => { if (!prev.classList.contains('is-on')) prev.pause(); }, 400);
    }
    shown = next;
  };

  const setPose = (name: string) => {
    if (!frames.has(name) || name === current) return;
    current = name;
    show(name);
  };

  {
    // `?motion` opts IN to the clips despite a reduced-motion setting. It exists
    // because the site's own author runs macOS with Reduce Motion on, and would
    // otherwise never see the avatar he paid to animate. It only ever widens
    // what the visitor explicitly asked for; nobody gets motion by default who
    // said they don't want it.
    const forced = new URLSearchParams(location.search).has('motion');
    if (forced) av?.classList.add('force-motion');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches && !forced;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const clips = [...document.querySelectorAll<HTMLVideoElement>('video.motion')];
    const attach = () => {
      for (const v of clips) {
        const name = v.dataset.motion ?? '';
        v.muted = true;                            // the attribute alone does not satisfy every autoplay policy
        for (const [src, type] of [[v.dataset.webm, 'video/webm'], [v.dataset.mp4, 'video/mp4']]) {
          if (!src) continue;
          const s = document.createElement('source');
          s.src = src;
          s.type = type as string;
          v.appendChild(s);
        }
        v.preload = 'auto';
        v.addEventListener('canplaythrough', () => {
          motion.set(name, v);
          if (current === name && shown !== v) show(name);
        }, { once: true });
        // A one-shot clip (the wave) ends on the still it started from; hand
        // back to idle so the face keeps breathing instead of freezing mid-hold.
        if (!v.loop) v.addEventListener('ended', () => { if (current === name) setPose('idle'); });
        v.load();
      }
    };
    if (!reduce && !saveData && clips.length) {
      const whenIdle = () => ('requestIdleCallback' in window
        ? window.requestIdleCallback(attach, { timeout: 3000 })
        : window.setTimeout(attach, 1200));
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    }
  }

  // ---- speech ----
  // The whole sentence appears at once (a quick fade, not a typewriter), then
  // the mouth moves gently for about as long as the line takes to say, then
  // settles. Only talk-open / talk-o ever alternate — they are identical apart
  // from the mouth, so the face never jumps.
  const PACE = {
    mouthMs: 1400,     // how long each mouth shape holds
    maxMouths: 3,      // hard cap on mouth changes per line
    perWord: 360,      // rough speaking time per word
    baseMs: 800,       // floor on top of that
    minLine: 2200,
    maxLine: 5200,
    fadeMs: 170,       // bubble swap
    holdEnd: 5200,     // line sits still, face at rest, before the next one
  };

  const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));
  let speakToken = 0;
  let mouthTimer: number | undefined;

  const stopMouth = () => {
    window.clearInterval(mouthTimer);
    mouthTimer = undefined;
    btn?.classList.remove('is-talking');
  };
  const stopSpeaking = () => { speakToken++; stopMouth(); };

  // The mouth moves a few times at the top of a line, then stops and the face
  // rests for the remainder — a nod at the sentence, not a lip-sync of it.
  const startMouth = (budget: number) => {
    stopMouth();
    btn?.classList.add('is-talking');
    let open = true;
    let left = Math.min(PACE.maxMouths, Math.max(1, Math.floor(budget / PACE.mouthMs)));
    setPose('talk-open');
    mouthTimer = window.setInterval(() => {
      open = !open;
      setPose(open ? 'talk-open' : 'talk-o');
      if (--left <= 0) stopMouth();
    }, PACE.mouthMs);
  };

  const speak = async (text: string, restPose = 'idle') => {
    if (!bubble) return;
    const token = ++speakToken;

    bubble.style.opacity = '0';
    await wait(PACE.fadeMs);
    if (token !== speakToken) return;

    bubble.textContent = text;              // full sentence, all at once
    bubble.style.opacity = '1';

    const words = text.trim().split(/\s+/).length;
    const spoken = Math.min(PACE.maxLine, Math.max(PACE.minLine, words * PACE.perWord + PACE.baseMs));
    startMouth(spoken);
    await wait(spoken);
    if (token !== speakToken) return;

    stopMouth();
    setPose(restPose);
  };

  const react = () => {
    btn?.classList.remove('is-react');
    void btn?.getBoundingClientRect();
    btn?.classList.add('is-react');
    window.setTimeout(() => btn?.classList.remove('is-react'), 520);
  };

  // Resting face per line — hand-picked and mostly just his normal face.
  // No guessing from the words; that was doing too much.
  const restFor = (idx: number) => (idx === 0 ? 'greet' : idx === lines.length - 1 ? 'zen' : 'idle');

  // Rotation waits for each line to finish speaking, so nothing overlaps.
  let rotating = false;
  // Generation token. stopRotation() can land while a loop sits inside an await;
  // the `if (rotating) return` guard then passes for the next startRotation() and
  // the OLD loop wakes to find rotating===true again, so two loops end up fighting
  // over bubble.textContent. Each loop captures its generation and exits if a newer
  // one has started.
  let generation = 0;
  const startRotation = async () => {
    if (rotating) return;
    // Text that rewrites itself under the reader is exactly what reduced-motion
    // is asking us not to do. Set the first line and stop. WCAG 2.2.2.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (bubble) { bubble.textContent = lines[0]; bubble.style.opacity = '1'; }
      setPose(restFor(0));
      return;
    }
    rotating = true;
    const mine = ++generation;
    while (rotating && mine === generation) {
      const line = lines[i];
      await speak(line, restFor(i));
      if (!rotating || mine !== generation) break;
      await wait(PACE.holdEnd);
      if (!rotating || mine !== generation) break;
      i = (i + 1) % lines.length;
    }
  };
  const stopRotation = () => { rotating = false; generation++; stopSpeaking(); };
  startRotation();

  // ---- chat ----
  const chat = document.getElementById('chat');
  const log = document.getElementById('chat-log');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLInputElement | null;
  const sendBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const sendGlyph = sendBtn?.textContent ?? '→';
  const suggest = document.getElementById('chat-suggest');
  const closeBtn = document.getElementById('chat-close');
  const history: { role: 'user' | 'assistant'; content: string }[] = [];
  let busy = false;

  const bubbleSay = (text: string, restPose = 'idle') => speak(text, restPose);

  // ---- rendering a reply ----
  // Things the bot names often enough to be worth clicking. Order matters:
  // the email has to match before the bare domain inside it does. Only routes
  // that actually exist are listed — there are no per-project pages.
  // Article paths come first: the bot is told to cite the full URL, and
  // "maystash.xyz/posts/<slug>/" must win over the bare-domain rule below it.
  const S = '(?:https?://)?';
  // Generated from src/posts by scripts/knowledge.mjs, so a new post becomes
  // clickable without anyone remembering to add it here. Drafts are excluded —
  // linking one would send visitors to a 404.
  import { POST_SLUGS } from '../lib/content.generated';
  const LINKS: { pattern: string; href: string }[] = [
    // `S` swallows an optional scheme so "https://" is never left stranded
    // outside the link text.
    ...POST_SLUGS.map((slug) => ({
      pattern: `${S}(?:maystash\\.xyz)?/?posts/${slug}/?`,
      href: `/posts/${slug}/`,
    })),
    { pattern: 'hello@maystash\\.xyz', href: 'mailto:hello@maystash.xyz' },
    { pattern: `${S}github\\.com/Mechmay`, href: 'https://github.com/Mechmay' },
    { pattern: `${S}dinjure\\.com`, href: 'https://dinjure.com' },
    { pattern: `${S}maystash\\.xyz/writing`, href: '/writing' },
    { pattern: `${S}maystash\\.xyz`, href: '/' },
    { pattern: '\\bDinjure\\b', href: '/projects' },
    { pattern: '\\bHash\\b', href: '/projects' },
  ];
  // One capture group per link, plus a final group for **bold** — the model
  // replies in light markdown and the asterisks were showing through raw.
  const RICH = new RegExp(
    `${LINKS.map((l) => `(${l.pattern})`).join('|')}|\\*\\*([^*]+)\\*\\*`,
    'g'
  );

  // Builds real DOM nodes rather than assigning innerHTML, so nothing the model
  // returns can inject markup no matter what it says.
  const renderReply = (text: string): DocumentFragment => {
    const frag = document.createDocumentFragment();
    let last = 0;
    let m: RegExpExecArray | null;
    RICH.lastIndex = 0;

    while ((m = RICH.exec(text)) !== null) {
      if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));

      const boldText = m[LINKS.length + 1];
      if (boldText !== undefined) {
        const strong = document.createElement('strong');
        strong.textContent = boldText;
        frag.appendChild(strong);
      } else {
        const idx = m.slice(1, LINKS.length + 1).findIndex((g) => g !== undefined);
        const a = document.createElement('a');
        a.href = LINKS[idx].href;
        a.textContent = m[0];
        if (LINKS[idx].href.startsWith('http')) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
        frag.appendChild(a);
      }
      last = m.index + m[0].length;
    }

    if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
    return frag;
  };

  const addMsg = (text: string, cls: string) => {
    if (!log) return null;
    const el = document.createElement('div');
    el.className = `msg ${cls}`;
    // Only the bot's own replies get links; anything the visitor typed stays
    // plain text.
    if (cls.startsWith('bot') && !cls.includes('think')) {
      el.appendChild(renderReply(text));
    } else {
      el.textContent = text;
    }
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  };

  // ---- follow-up suggestions ----
  // Picked from a curated pool by what the answer mentioned, rather than asking
  // the model to invent them: no extra tokens, no latency, and the questions
  // are ones the knowledge base can actually answer well.
  const FOLLOWUPS: { when: RegExp; asks: string[] }[] = [
    { when: /dinjure|guessing game/i, asks: ["How does Dinjure work?", "Did anyone cheat at Dinjure?"] },
    { when: /\bhash\b|agent|telegram/i, asks: ["What can Hash actually do?", "How are his agents kept safe?"] },
    { when: /water|burger|data cent/i, asks: ["How much water does a burger use?", "Which AI labs publish water data?"] },
    { when: /wrote|writing|article|blog|post/i, asks: ["What should I read first?", "What's the matinee section?"] },
    { when: /email|reach|hire|contact/i, asks: ["What work does May take on?", "What is he building now?"] },
    { when: /security|web3|prompt injection/i, asks: ["What's May's background?", "What is prompt injection?"] },
  ];
  const DEFAULT_ASKS = ["What is May building now?", "What should I read first?", "How do I reach him?"];
  const asked = new Set<string>();

  const showSuggestions = (reply: string) => {
    if (!suggest) return;
    const pool: string[] = [];
    for (const { when, asks } of FOLLOWUPS) {
      if (when.test(reply)) pool.push(...asks);
    }
    pool.push(...DEFAULT_ASKS);

    const picks = pool.filter((q) => !asked.has(q.toLowerCase())).slice(0, 3);
    suggest.textContent = '';
    if (!picks.length) {
      suggest.setAttribute('hidden', '');
      return;
    }
    for (const q of picks) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = q;
      suggest.appendChild(b);
    }
    suggest.removeAttribute('hidden');
  };

  const openChat = () => {
    if (!chat) return;
    stopRotation();
    chat.hidden = false;
    bubbleSay('Ask me anything.', 'greet');
    input?.focus();
  };

  const closeChat = () => {
    if (!chat) return;
    chat.hidden = true;
    // Without this focus lands on <body> and a keyboard user loses their place
    // entirely — they have to tab back from the skip link.
    btn?.focus();
    startRotation();
  };

  const ask = (question: string) => {
    if (busy || !question.trim()) return false;
    void run(question);
    return true;
  };

  // A rejected submit has to be visible. Without this the controls stay live,
  // `ask()` returns false, and pressing Send produces literally nothing — the
  // classic "is it broken or am I?" moment, on the one control the page is
  // asking a stranger to trust.
  const setBusy = (state: boolean) => {
    busy = state;
    if (input) input.disabled = state;
    if (sendBtn) {
      sendBtn.disabled = state;
      sendBtn.textContent = state ? '…' : sendGlyph;
    }
    form?.setAttribute('aria-busy', state ? 'true' : 'false');
    // Disabling an element blurs it, so re-enabling has to hand focus back or
    // the visitor is left with no caret and nothing focused after every reply.
    if (!state && chat && !chat.hidden) input?.focus();
  };

  const run = async (question: string) => {
    setBusy(true);
    asked.add(question.trim().toLowerCase());
    suggest?.setAttribute('hidden', '');
    addMsg(question, 'you');
    const pending = addMsg('thinking…', 'bot think');
    stopSpeaking();
    setPose('think');
    if (bubble) { bubble.textContent = 'Thinking…'; bubble.style.opacity = '1'; }

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, history }),
      });
      const data = await res.json().catch(() => ({}));
      const reply = data.reply ?? 'Something went wrong. Try again.';
      pending?.remove();
      addMsg(reply, res.ok ? 'bot' : 'bot err');
      history.push({ role: 'user', content: question }, { role: 'assistant', content: reply });
      // The bubble is plain text, so drop the markdown the chat log renders.
      const spoken = reply.replace(/\*\*/g, '').replace(/\s+/g, ' ').trim();
      bubbleSay(spoken.length > 46 ? spoken.slice(0, 44).trimEnd() + '…' : spoken);
      // Not gated on res.ok. A failed request is exactly when the visitor has
      // the least idea what to do next; hiding the only remaining affordances
      // turns the panel into a dead end.
      showSuggestions(res.ok ? reply : '');
    } catch {
      pending?.remove();
      addMsg("Couldn't reach the server. Check your connection and try again.", 'bot err');
      setPose('idle');  // 'no' is not in POSES — setPose would no-op and freeze the face in `think`.
      // The bubble was set to 'Thinking…' at the top of run(). Without this it
      // stays there forever, so the avatar claims it is still thinking while the
      // log says the request failed.
      bubbleSay("Couldn't reach the server.");
      showSuggestions('');
    } finally {
      setBusy(false);
    }
  };

  btn?.addEventListener('click', () => {
    if (chat?.hidden) { openChat(); return; }
    stopSpeaking();
    i = (i + 1) % lines.length;
    react();
    speak(lines[i], restFor(i));
  });

  closeBtn?.addEventListener('click', closeChat);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    const q = input.value;
    // Clear ONLY once ask() has accepted. It returns early while `busy`, and the
    // old order cleared first — so a question typed during an in-flight reply was
    // destroyed silently, with no message and nothing to retry.
    if (ask(q)) input.value = '';
  });

  suggest?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'BUTTON') ask(target.textContent ?? '');
  });

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && chat && !chat.hidden) closeChat();
  });
</script>
