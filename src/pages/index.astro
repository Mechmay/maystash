---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.slice(0, 3);

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const projects = allProjects.slice(0, 3);

// ---- the proof strip ----------------------------------------------------
// A live window, never a hand-picked pair. `lead` is whatever post carries the
// newest date; publish something dated later and it takes the slot on the next
// build with no edit here. `shipped` searches the WHOLE project set, not the
// three the grid below happens to show.
const lead = allPosts.at(0);
const shipped = allProjects.find((p) => p.data.status === 'live') ?? allProjects.at(0);
const shippedHref = shipped?.data.url ?? '/projects';
const shippedExternal = shipped?.data.url?.startsWith('http') ?? false;

// ---- The Currency Rule --------------------------------------------------
// `NOW SHOWING` is a claim about currency, so it has to be able to stop making
// it. Past the window the row keeps its place and stops overselling: the post
// is still the newest thing here, it just isn't news any more.
//
// 45 days is derived, not chosen by feel. Observed cadence across the live
// posts is a 7-day median gap and a 13-day worst gap, so the window sits at
// 3.5x the worst normal silence. A false "stale" on an active site is the more
// expensive error — it makes a running site look abandoned — so the window errs
// long.
const FRESH_DAYS = 45;
const freshUntil = lead ? new Date(lead.data.date.valueOf() + FRESH_DAYS * 864e5) : null;
// Build-time answer. Corrected on the client below, because a static page built
// six months ago would otherwise still be insisting it is current — the case
// this rule exists for.
const leadIsFresh = freshUntil ? Date.now() < freshUntil.valueOf() : true;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' }).toUpperCase();

const statusLabel: Record<string, string> = {
  live: 'NOW PLAYING',
  building: 'IN PRODUCTION',
  archived: 'IN THE VAULT',
};

// The strip row answers "has he shipped anything", so `live` reads SHIPPED where
// the cards below read NOW PLAYING. The other two are the cards' own words on
// purpose — the strip and the grid must never describe the same project
// differently. Archived is not "in production": it is shelved, and saying
// otherwise claims work nobody is doing.
const stripKick: Record<string, string> = {
  ...statusLabel,
  live: 'SHIPPED',
};

// Which avatar frame set the launcher uses. Both live under public/ and hold
// the same six frame names, so switching is a one-word rollback.
//   'avatar'    — the original Apple Memoji cut-outs (head only)
//   'avatar-v2' — AInfluencer-generated 3D character (head + shoulders)
const AVATAR_SET = 'avatar-v2';
const POSES = ['idle', 'talk-open', 'talk-o', 'think', 'greet', 'zen'];
// Poses that also have a rendered motion clip (public/<set>/motion/<name>.webm|mp4).
// Rendered on Vertex Veo from that pose's own still, with the SAME frame passed as
// first and last frame, so a clip starts and ends on the still it replaces and
// the idle loop has no seam. Talking stays on the stills: a pre-rendered clip
// cannot lip-sync a sentence nobody has written yet.
const MOTION = AVATAR_SET === 'avatar-v2' ? ['idle', 'greet'] : [];
---
<Layout title="maystash — May builds, breaks, and writes it down" bareNav={true}>
  {/* The corner nav lives OUTSIDE <main> — it is site navigation repeated on
      every page, and a landmark you skip TO should not contain the thing you
      are skipping PAST. It still has to pin to the hero's box, so this frame
      reproduces that box: absolutely positioned with no positioned ancestor,
      it resolves against the initial containing block, which is anchored at the
      document origin and is exactly one viewport wide. Same four corners, same
      scroll-away behaviour, different place in the document. */}
  <div class="corner-frame">
    <Nav variant="corners" />
  </div>

  <main class="home" id="main">
    <!-- LAUNCHER HERO -->
    <header class="launch">
      <div class="stage">
        <div class="stage-main">
          <h1 class="stage-name">MAYSTASH</h1>
          <p class="stage-tag">Security, web3, and applied AI — <em>built, broken, and written down</em> by one person.</p>

          <div class="strip">
            {lead && (
              <a class="strip-row" href={`/posts/${lead.id}/`}>
                <span class="strip-kick mono" data-fresh-until={freshUntil?.toISOString()}>
                  {leadIsFresh ? 'NOW SHOWING' : 'LAST SCREENED'}
                </span>
                <span class="strip-title">{lead.data.title}</span>
                <span class="strip-meta mono">{fmt(lead.data.date)}</span>
              </a>
            )}
            {shipped && (
              <a
                class="strip-row"
                href={shippedHref}
                target={shippedExternal ? '_blank' : undefined}
                rel={shippedExternal ? 'noopener' : undefined}
              >
                <span class="strip-kick mono">
                  {shipped.data.status === 'live' && <span class="strip-dot"></span>}
                  {stripKick[shipped.data.status] ?? statusLabel.building}
                </span>
                <span class="strip-title">{shipped.data.title}</span>
                <span class="strip-meta mono">{shipped.data.tags.slice(0, 2).join(' · ')}</span>
              </a>
            )}
          </div>

          <div class="stage-cta mono">
            <a class="cta-strong" href="mailto:hello@maystash.xyz">WORK WITH ME →</a>
            <a class="cta-weak" href="/writing">ALL WRITING</a>
            <a class="cta-ghost" href="https://github.com/Mechmay" target="_blank" rel="me noopener">GITHUB <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <a href="/ctf" class="ctf-hero mono">⚑ CTF</a>

        <button class="avatar-wrap" id="avatar" type="button" aria-label="Chat with May — ask about him, his projects and his writing">
          <div class="bubble mono" id="bubble">Hey, I'm May 👋</div>
          <div class="av" id="av" data-set={AVATAR_SET}>
            {POSES.map((pose, n) => (
              <img
                class={n === 0 ? 'pose is-on' : 'pose'}
                data-pose={pose}
                src={`/${AVATAR_SET}/${pose}.webp`}
                alt={n === 0 ? 'May' : ''}
                aria-hidden={n === 0 ? undefined : 'true'}
                fetchpriority={n === 0 ? 'high' : undefined}
                width="768"
                height="768"
              />
            ))}
            {/* No <source> here on purpose: the script attaches it after the page
                has loaded and gone idle, so a clip never competes with the
                first paint or the high-priority still above. No JS, reduced
                motion, or Save-Data = the stills, exactly as before. */}
            {MOTION.map((m) => (
              <video
                class="pose motion"
                data-motion={m}
                data-webm={`/${AVATAR_SET}/motion/${m}.webm`}
                data-mp4={`/${AVATAR_SET}/motion/${m}.mp4`}
                muted
                playsinline
                loop={m === 'idle'}
                preload="none"
                aria-hidden="true"
                width="480"
                height="480"
              />
            ))}
          </div>
          <span class="avatar-hint mono">↑ CLICK TO CHAT WITH ME</span>
        </button>

        <!-- CHAT PANEL -->
        <div class="chat" id="chat" hidden>
          <div class="chat-head mono">
            <span>ASK ABOUT MAY</span>
            <button type="button" class="chat-close" id="chat-close" aria-label="Close chat">✕</button>
          </div>
          <div class="chat-log" id="chat-log" aria-live="polite"></div>
          <div class="chat-suggest mono" id="chat-suggest">
            <button type="button">What is May building?</button>
            <button type="button">What's Dinjure?</button>
            <button type="button">How do I hire him?</button>
          </div>
          <form class="chat-form" id="chat-form">
            <input
              id="chat-input"
              type="text"
              maxlength="500"
              autocomplete="off"
              placeholder="Ask me anything about May…"
              aria-label="Ask a question about May"
            />
            <button type="submit" class="mono" aria-label="Send">→</button>
          </form>
        </div>
      </div>
      <div class="roll mono">↓ ROLL FILM</div>
    </header>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track mono">
        {Array(2).fill(0).map(() => (
          <span>SECOND BRAINS · AI AGENTS · SECURITY · WEB3 · SHIPPING 0→1 · PLAIN TEXT SUPREMACY · SECOND BRAINS · AI AGENTS · SECURITY · WEB3 · SHIPPING 0→1 · PLAIN TEXT SUPREMACY · </span>
        ))}
      </div>
    </div>

    <!-- WRITING ARM (paper) -->
    <section id="writing" class="arm paper">
      <div class="arm-head reveal">
        <div class="arm-slate mono">NOW SHOWING — THE WRITING</div>
        <a href="/writing" class="arm-all mono">ALL WRITING →</a>
      </div>
      {posts.map((post) => (
        <a href={`/posts/${post.id}/`} class="pcard reveal">
          <div class="pcard-ch mono">CH.{post.data.chapter}</div>
          <div class="pcard-body">
            <h2 class="pcard-title">{post.data.title}</h2>
            <p class="pcard-tag">{post.data.tagline}</p>
            <div class="pcard-meta mono"><span>{fmt(post.data.date)}</span><span class="cta">WATCH →</span></div>
          </div>
        </a>
      ))}
    </section>

    <!-- PROJECTS ARM (klein block) -->
    <section id="projects" class="arm block-klein">
      <div class="arm-head reveal">
        <div class="arm-slate mono light">IN PRODUCTION — THE WORK</div>
        <a href="/projects" class="arm-all mono light">ALL PROJECTS →</a>
      </div>
      <div class="prod-grid">
        {projects.map((p) => (
          <a href={p.data.url ?? '/projects'} class="prod-card reveal" target={p.data.url?.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <div class="pc-status mono" data-status={p.data.status}><span class="dot"></span>{statusLabel[p.data.status]}</div>
            <h3 class="pc-title">{p.data.title}</h3>
            <p class="pc-tag">{p.data.tagline}</p>
            <div class="pc-tags mono">{p.data.tags.slice(0, 3).map((t) => <span>{t}</span>)}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- ABOUT ARM (acid block) -->
    <section class="arm block-acid reveal">
      <div class="arm-slate mono dark">CAST &amp; CREW — ONE PERSON, MANY HATS</div>
      <p class="about-text">One builder across cybersecurity, web3, applied AI, and 0→1 products. This site is where the useful stuff gets written down properly — long-form, no fluff, everything reproducible.</p>
      <a href="/about" class="arm-all mono dark">MORE ABOUT ME →</a>
    </section>

    <!-- CONTACT (dark) -->
    <section id="contact" class="contact reveal">
      <div class="arm-slate mono">— GET IN TOUCH —</div>
      <h2 class="contact-title">LET'S<br />TALK</h2>
      <p class="contact-text">Building something, want to collaborate, or just have a good argument about AI and water? One inbox, always open.</p>
      <div class="contact-links">
        <a href="mailto:hello@maystash.xyz" class="c-link mono primary">HELLO@MAYSTASH.XYZ</a>
        <a href="https://github.com/Mechmay" target="_blank" rel="me noopener" class="c-link mono">GITHUB — MECHMAY</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Paper tokens are global now — see src/styles/tokens.css. */

  /* Reproduces the hero's box for the corner nav without wrapping it. The frame
     itself must not eat clicks meant for the avatar underneath — the corners
     take their own pointer events back in Nav.astro. */
  .corner-frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100svh;
    pointer-events: none;
    z-index: 4;
  }

  /* Phone-only twin of the corner nav's CTF link. Hidden above 620px, where the
     top-centre corner carries it instead. Only one is ever rendered, so it is
     one link in the accessibility tree, not two. */
  .ctf-hero { display: none; }
  @media (max-width: 620px) {
    .ctf-hero {
      display: block;
      justify-self: center;
      margin: 1.5rem auto -0.5rem;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--paper-ink);
      text-decoration: none;
      padding: 0.6rem 0.7rem;
      border: 1px solid var(--ink-a35);
      border-radius: var(--r-pill);
    }
    .ctf-hero:hover,
    .ctf-hero:focus-visible { border-color: var(--klein); color: var(--klein); }
    .ctf-hero:focus-visible { outline: 2px solid var(--klein); outline-offset: 3px; }
  }

  /* ---- launcher hero ---- */
  .launch {
    position: relative;
    min-height: 100svh;
    background: var(--paper);
    color: var(--paper-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* On a short screen the hero is taller than the viewport, and plain
       centring overflows it past BOTH edges — which is how the speech bubble
       ended up on top of the corner links. `safe` centres only while it fits
       and falls back to the start edge once it doesn't, so the bubble always
       stays below the padding. Older engines ignore the line and keep the
       plain `center` above it. */
    justify-content: safe center;
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
  }
  /* Corner-nav styles live in src/components/Nav.astro. */

  /* comic speech bubble — tail points down into the avatar */
  .bubble {
    position: absolute;
    bottom: calc(100% - 10px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--paper-hi);
    color: var(--paper-ink);
    border: 2.5px solid var(--paper-ink);
    border-radius: var(--r-bubble);
    padding: 0.65rem 1.05rem;
    font-size: var(--step-label);
    line-height: 1.5;
    white-space: nowrap;
    /* absolute + left:50% inside a narrow wrapper would shrink-to-fit to half
       the avatar's width; max-content lets it use its real text width instead */
    width: max-content;
    max-width: min(24rem, 86vw);
    box-shadow: var(--offset-print-sm);
    z-index: 3;
    transition: opacity 0.17s ease;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -10px;
    margin-left: -8px;
    width: 15px; height: 15px;
    background: var(--paper-hi);
    border-right: 2.5px solid var(--paper-ink);
    border-bottom: 2.5px solid var(--paper-ink);
    transform: rotate(45deg);
  }
  /* Mobile: the bubble grows UPWARD out of the avatar, so a long line used to
     climb into the corner nav. Keep it to at most two lines and give the hero
     enough headroom that two lines still clear the links. */
  @media (max-width: 620px) {
    .bubble {
      white-space: normal;
      text-align: center;
      bottom: calc(100% + 4px);
      max-width: 82vw;
      font-size: var(--step-floor);
      line-height: 1.45;
      padding: 0.55rem 0.85rem;
      overflow-wrap: break-word;
    }
  }

  /* Evidence left, avatar right. On a narrow screen the grid collapses to one
     column and DOM order carries the sequence — wordmark, line, strip, actions,
     THEN the avatar. No `order` property anywhere: the reading order a screen
     reader gets is the order everyone gets. */
  .stage {
    width: 100%;
    max-width: 68rem;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    text-align: left;
  }
  .stage > .chat { grid-column: 1 / -1; justify-self: center; }

  /* ---- proof strip ---- */
  .strip { margin-top: 1.8rem; border-top: 1px solid var(--paper-rule); }
  .strip-row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--paper-rule);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-state) ease;
  }
  .strip-row:hover .strip-title,
  .strip-row:focus-visible .strip-title { color: var(--klein); }
  /* Colour alone is not a focus indicator. Klein responds on paper (6.95:1). */
  .strip-row:focus-visible { outline: 2px solid var(--klein); outline-offset: 3px; }
  .strip-kick {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: var(--step-floor); letter-spacing: 0.14em; color: var(--paper-mute);
  }
  /* live tally. Klein, not acid — acid on paper measures 1.02:1 and would be an
     invisible dot claiming to signal "shipped". See The Ground Decides Rule. */
  .strip-dot { width: 7px; height: 7px; border-radius: var(--r-dot); background: var(--klein); }
  .strip-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.1rem, 2.4vw, 1.7rem); line-height: 1.1;
    text-transform: uppercase; color: var(--paper-ink);
  }
  .strip-meta { font-size: var(--step-floor); color: var(--paper-mute); white-space: nowrap; }

  /* ---- actions ---- */
  .stage-cta { display: flex; gap: 1.2rem; align-items: center; margin-top: 1.6rem; flex-wrap: wrap; }
  .cta-strong {
    background: var(--klein); color: var(--paper-hi); text-decoration: none;
    padding: 0.7rem 1.2rem; font-size: var(--step-label); letter-spacing: 0.12em; font-weight: 700;
  }
  .cta-weak {
    color: var(--paper-mute); text-decoration: none;
    font-size: var(--step-label); letter-spacing: 0.12em;
    border-bottom: 2px solid var(--paper-rule); padding-bottom: 2px;
    transition: color var(--dur-state) ease, border-color var(--dur-state) ease;
  }
  .cta-weak:hover,
  .cta-weak:focus-visible { color: var(--klein); border-bottom-color: var(--klein); }
  .cta-weak:focus-visible { outline: 2px solid var(--klein); outline-offset: 3px; }
  /* Klein ring around a klein block reads as a fat border, not focus — the
     primary action takes the ink ring instead. */
  .cta-strong:focus-visible { outline: 2px solid var(--paper-ink); outline-offset: 3px; }
  /* Tertiary. A credential, not an action — quieter than ALL WRITING on purpose,
     so the row still reads as one primary and one secondary. `rel="me"` keeps
     the IndieWeb identity link the old hero carried. */
  /* Sits after a wider gap than the secondary link, and carries the off-site
     mark. Contrast floor rules out going lighter (--paper-dim is 3.11:1), and
     the label is already at the 11px floor, so hierarchy comes from treatment,
     not from shrinking it into an accessibility failure. */
  .cta-ghost {
    margin-left: 0.6rem;
    color: var(--paper-mute); text-decoration: none;
    font-size: var(--step-label); letter-spacing: 0.12em;
    border-bottom: 2px solid transparent; padding-bottom: 2px;
    transition: color var(--dur-state) ease, border-color var(--dur-state) ease;
  }
  .cta-ghost:hover,
  .cta-ghost:focus-visible { color: var(--klein); border-bottom-color: var(--klein); }
  .cta-ghost:focus-visible { outline: 2px solid var(--klein); outline-offset: 3px; }
  .avatar-wrap {
    position: relative;
    display: inline-block;
    justify-self: center;
    /* The bubble is absolutely positioned above the avatar, so it contributes
       nothing to layout height. This margin reserves its space in flow —
       without it the centring has no idea the bubble is there and lets it
       ride up over the corner links on short screens. */
    margin-top: 4.5rem;
    margin-bottom: 1.5rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .av {
    position: relative;
    width: clamp(170px, 34vw, 240px);
    aspect-ratio: 1;
    display: block;
    border-radius: var(--r-dot);
    background: var(--klein);
    border: 3px solid var(--paper-ink);
    /* clip the memoji INTO the disc — the circle does the cutting, so the
       square edge at the bottom of the PNG never shows */
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.25s ease;
  }
  .avatar-wrap:hover .av,
  .avatar-wrap:focus-visible .av { transform: scale(1.03) rotate(-1deg); }
  .avatar-wrap:active .av { transform: scale(0.98); }

  .pose {
    position: absolute;
    left: 50%;
    bottom: -16%;
    width: 128%;
    transform: translateX(-50%);
    object-fit: contain;
    object-position: bottom center;
    image-rendering: -webkit-optimize-contrast;
    opacity: 0;
    transition: opacity 0.34s ease;   /* slow cross-fade = morph, not snap */
    pointer-events: none;
  }
  .pose.is-on { opacity: 1; }

  /* v2 frames are rendered head-and-shoulders inside a square with the
     background already cut out, so they fill the disc instead of hanging
     off the bottom of it like the head-only memoji cut-outs do. */
  .av[data-set='avatar-v2'] .pose {
    bottom: -6%;
    width: 112%;
    height: auto;   /* without this the height attribute wins and object-fit
                       silently letterboxes the frame inside a 768px-tall box */
  }

  /* Always visible — hiding this until hover meant nobody on a phone ever
     learned the avatar was clickable. var(--paper-dim) only made 3.1:1 against the
     paper, under the 4.5:1 small-text minimum, so it darkens to 4.8:1. */
  .avatar-hint {
    display: block;
    margin-top: 0.9rem;
    /* Was 0.62rem = 9.92px. This is the only thing telling anyone the avatar is
       clickable, and it was under the 11px floor on desktop. Contrast was already
       fixed here; the size was the half that got left behind. */
    font-size: var(--step-floor);
    letter-spacing: 0.16em;
    color: #6b675d;
    transition: color var(--dur-state) ease;
  }
  .avatar-wrap:hover .avatar-hint,
  .avatar-wrap:focus-visible .avatar-hint { color: var(--klein); }

  /* ---- motion: the memoji itself is the art, CSS adds life ---- */
  .av { animation: sway 12s ease-in-out infinite; transform-origin: 50% 85%; }
  .avatar-wrap.is-talking .av { animation: sway 12s ease-in-out infinite, nod 1.4s ease-in-out infinite; }
  .avatar-wrap.is-react .av { animation: sway 12s ease-in-out infinite, pop 0.5s var(--ease-reveal); }

  @keyframes sway {
    0%, 100% { rotate: -1.2deg; translate: 0 0; }
    25%      { rotate: 0.3deg; translate: 0 -2px; }
    50%      { rotate: 1.2deg;  translate: 0 0; }
    75%      { rotate: 0.2deg; translate: 0 -1px; }
  }
  @keyframes nod { 0%, 100% { translate: 0 0; } 50% { translate: 0 2px; } }
  @keyframes pop { 0% { scale: 1; } 40% { scale: 1.07; } 100% { scale: 1; } }

  /* ---- chat panel ---- */
  .chat {
    width: min(30rem, 92vw);
    margin: 1.6rem auto 0;
    text-align: left;
    background: var(--paper-hi);
    border: 2px solid var(--paper-ink);
    border-radius: var(--r-panel);
    box-shadow: var(--offset-print-lg);
    overflow: hidden;
  }
  .chat[hidden] { display: none; }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: var(--paper-ink);
    color: var(--paper);
    letter-spacing: 0.14em;
  }
  .chat-close {
    background: none; border: none; cursor: pointer;
    color: var(--paper); font-size: var(--step-meta); line-height: 1; padding: 0.2rem;
  }
  .chat-close:hover,
  .chat-close:focus-visible { color: var(--acid); }
  .chat-log {
    max-height: 15rem;
    overflow-y: auto;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .chat-log:empty { display: none; }
  .msg { font-size: var(--step-sm); line-height: 1.5; max-width: 85%; padding: 0.55rem 0.8rem; border-radius: var(--r-bubble-sm); }
  .msg.you { align-self: flex-end; background: var(--klein); color: var(--bone); }
