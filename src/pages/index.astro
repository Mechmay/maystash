  .prod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; max-width: 1200px; margin: 0 auto; }
  .prod-card { display: flex; flex-direction: column; padding: 1.8rem 1.6rem; border: 1px solid var(--bone-a28); border-radius: var(--r-card); text-decoration: none; color: var(--bone); transition: border-color var(--dur-state) ease, background var(--dur-state) ease; }
  /* Border carries the hover alone: no elevation (The Flat-Everywhere-Else Rule),
