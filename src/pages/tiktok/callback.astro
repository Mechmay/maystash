---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// OAuth redirect target for the "Automate" TikTok app.
//
// DESIGN NOTE, and it is the whole reason this page is dumb on purpose.
//
// The obvious build is to exchange the authorization code for tokens right
// here. That would require TIKTOK_CLIENT_SECRET in Vercel's environment --
// a THIRD place a master credential lives, on a public web host, to support an
// exchange that happens roughly once a year.
//
// So this page does not touch the secret. It displays the authorization code
// and the operator pastes it into `scripts/tiktok-auth.mjs`, which already has
// the secret in .env and writes the tokens straight to cm_tokens. The secret
// stays in the two places it already is; the code is single-use and expires in
// minutes, so showing it in the browser that just completed the flow adds
// nothing an attacker could use.
//
// Kept out of search via public/robots.txt rather than a meta tag: the shared
// Layout exposes only a default slot, so a per-page <meta> in the head is not
// expressible without changing the layout every other page depends on.

const url = Astro.url;
const code = url.searchParams.get('code');
const error = url.searchParams.get('error');
const errorDesc = url.searchParams.get('error_description');
const state = url.searchParams.get('state');
---

<Layout title="TikTok authorization" description="OAuth redirect target.">
  <main class="cb" id="main">
    <p class="eyebrow mono">AUTOMATE · TIKTOK AUTHORIZATION</p>

    {error && (
      <>
        <h1>Authorization failed</h1>
        <p class="err mono">{error}</p>
        {errorDesc && <p>{errorDesc}</p>}
        <p>Nothing was stored. Start the flow again from the terminal.</p>
      </>
    )}

    {!error && code && (
      <>
        <h1>Authorized</h1>
        <p>Copy this code and paste it into the terminal command waiting for it. It is
           single-use and expires within minutes.</p>
        <pre class="code"><code>{code}</code></pre>
        {state && <p class="state mono">state: {state}</p>}
        <p class="hint">
          <code>node --env-file=.env scripts/tiktok-auth.mjs --code &lt;paste&gt;</code>
        </p>
      </>
    )}

    {!error && !code && (
      <>
        <h1>Nothing to do</h1>
        <p>This page is the redirect target for a TikTok authorization flow. Opening it
           directly does nothing.</p>
      </>
    )}
  </main>
</Layout>

<style>
  .cb {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.25rem 6rem;
    line-height: 1.65;
  }
  .eyebrow { font-size: 0.72rem; letter-spacing: 0.16em; opacity: 0.6; margin: 0 0 1rem; }
  .cb h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); margin: 0 0 1rem; }
  .code {
    padding: 1rem 1.1rem;
    border-radius: 3px;
    overflow-x: auto;
    font-size: 0.82rem;
    word-break: break-all;
    white-space: pre-wrap;
    border: 1px solid currentColor;
  }
  .state, .hint { font-size: 0.78rem; opacity: 0.7; }
  .err { font-weight: 600; }
</style>
