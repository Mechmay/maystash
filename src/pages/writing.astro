---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = all.filter((p) => p.data.section === 'feature');
const matinee = all.filter((p) => p.data.section === 'matinee');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' }).toUpperCase();
const readMins = (body: string) => Math.max(1, Math.round(body.split(/\s+/).length / 220));
---
<Layout title="Writing — maystash" description="Long-form, reproducible writing on AI agents, second brains, security, and building 0→1. Written by May.">
  <header class="page-head">
    <div class="ph-slate mono"><span>REEL 001</span><span>THE WRITING</span></div>
    <h1 class="ph-title">NOW<br />SHOWING</h1>
    <p class="ph-tagline">Long-form, no fluff, everything reproducible. Technical field notes up top — plain-language <em>Matinee</em> screenings below.</p>
  </header>

  <main class="reel">
    <div class="reel-header mono reveal">FEATURE PRESENTATION</div>

    {posts.map((post) => (
      <a href={`/posts/${post.id}/`} class="card reveal">
        <div class="card-ch mono">CH.{post.data.chapter}</div>
        <div class="card-body">
          <h2 class="card-title">{post.data.title}</h2>
          <p class="card-tagline">{post.data.tagline}</p>
          <div class="card-meta mono">
            <span>{fmt(post.data.date)}</span>
            <span>{readMins(post.body ?? '')} MIN READ</span>
            <span class="card-cta">WATCH →</span>
          </div>
        </div>
      </a>
    ))}

    {matinee.length > 0 && (
      <>
        <div class="reel-header mono reveal matinee-header">MATINEE SCREENINGS — NO JARGON, EVERYONE WELCOME</div>
        {matinee.map((post) => (
          <a href={`/posts/${post.id}/`} class="card reveal">
            <div class="card-ch mono">CH.{post.data.chapter}</div>
            <div class="card-body">
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-tagline">{post.data.tagline}</p>
              <div class="card-meta mono">
                <span>{fmt(post.data.date)}</span>
                <span>{readMins(post.body ?? '')} MIN READ</span>
                <span class="card-cta">WATCH →</span>
              </div>
            </div>
          </a>
        ))}
      </>
    )}

    <div class="soon reveal">
      <div class="soon-label mono">COMING SOON TO THIS THEATRE</div>
      <ul class="soon-list">
        <li><span class="mono">CH.02</span> Build logs — shipping products in public, scars included</li>
        <li><span class="mono">CH.03</span> Security field notes — how things break, told like heists</li>
        <li><span class="mono">CH.04</span> Agent experiments — loops, dreams, and controlled chaos</li>
        <li><span class="mono">MATINEE</span> Plain-language screenings — tech questions everyone asks, answered without the jargon</li>
      </ul>
    </div>
  </main>
</Layout>

<style>
  .page-head { max-width: 1200px; margin: 0 auto; padding: 9rem 2rem 1rem; }
  .ph-slate { display: flex; gap: 2.2rem; color: var(--bone-dim); margin-bottom: 1.6rem; }
  .ph-title {
    font-family: var(--font-display);
    font-size: var(--type-page-hero);
    line-height: 0.9;
    color: var(--bone);
    text-shadow: var(--shadow-print);
  }
  .ph-tagline { max-width: 40rem; margin-top: 1.8rem; font-size: var(--step-lead); color: var(--bone-dim); }
  .ph-tagline em { color: var(--acid); font-style: italic; }

  .reel { max-width: 1200px; margin: 0 auto; padding: 3rem 2rem 5rem; }
  .reel-header { color: var(--bone-dim); margin-bottom: 2.2rem; }
  .matinee-header { margin-top: 4.5rem; color: var(--acid); }

  .card {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 2.4rem 1.6rem;
    border-top: 1px solid var(--rule-dim);
    text-decoration: none;
    color: inherit;
    transition: background 0.25s ease;
  }
  .card:hover, .card:focus-visible { background: var(--klein); }
  .card:hover .card-ch, .card:hover .card-meta,
  .card:focus-visible .card-ch, .card:focus-visible .card-meta { color: var(--bone); }
  .card-ch { color: var(--acid); padding-top: 0.6rem; min-width: 4.5rem; }
  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    line-height: 1.05;
    color: var(--bone);
    text-transform: uppercase;
  }
  .card-tagline { margin-top: 0.9rem; font-size: 1.15rem; font-style: italic; color: var(--bone-dim); max-width: 52rem; }
  .card:hover .card-tagline, .card:focus-visible .card-tagline { color: var(--bone); }
  .card-meta { display: flex; gap: 2rem; margin-top: 1.3rem; color: var(--bone-dim); flex-wrap: wrap; }
  /* Acid at rest, and it stays acid through the klein fill (7.07:1). The card
     itself carries the hover response; the CTA is a constant marker.
     Kept identical to /projects' VISIT — see DESIGN.md, The Twin Reels Rule. */
  .card-cta { color: var(--acid); }
  .card:hover .card-meta .card-cta,
  .card:focus-visible .card-meta .card-cta { color: var(--acid); }

  .soon { border-top: 1px solid var(--rule-dim); padding: 3rem 1.6rem; }
  .soon-label { color: var(--bone-dim); margin-bottom: 1.4rem; }
  .soon-list { list-style: none; }
  .soon-list li { padding: 0.7rem 0; color: var(--bone-dim); font-size: 1.1rem; font-style: italic; display: flex; gap: 1.4rem; align-items: baseline; }
  .soon-list .mono { color: var(--bone-dim); font-style: normal; }

  @media (max-width: 640px) { .card { flex-direction: column; gap: 0.6rem; } }
</style>
